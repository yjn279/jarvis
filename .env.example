# ── Jarvis 設定 ───────────────────────────────────────────────
# このファイルを .env にコピーして値を埋める。.env は .gitignore 済み。

# 【必須】Discord Bot トークン
# Developer Portal → アプリ作成 → Bot → Reset Token で取得。
DISCORD_BOT_TOKEN=

# 専用サーバー(Guild)ID。`npm run setup` が自動作成して自動で書き込む。
# 設定されていると、このサーバー以外のメッセージは無視する。
JARVIS_GUILD_ID=

# 秘書が反応するチャンネルID。`npm run setup` が自動で書き込む。
# 未設定なら専用サーバー内の全チャンネルで反応する。
JARVIS_CHANNEL_ID=

# Claude のパーミッションモード: default | acceptEdits | plan | bypassPermissions
# 会話だけなら default で十分。ファイル操作など道具を使わせたいなら bypassPermissions。
CLAUDE_PERMISSION_MODE=default

# 秘書が claude を動かす作業ディレクトリ。既定はリポジトリ内 ./workspace。
# JARVIS_WORKDIR=

# 使う Claude モデル（任意。未設定なら既定モデル）。
# CLAUDE_MODEL=

# セッション対応表の保存ディレクトリ。既定は ./data。
# JARVIS_DATA_DIR=
