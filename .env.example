# -----------------------------------------------------------------------
# Discord Bot Token (required)
# Obtain from https://discord.com/developers/applications
# -----------------------------------------------------------------------
DISCORD_BOT_TOKEN=

# -----------------------------------------------------------------------
# Access control — comma-separated Discord user IDs that may invoke the
# bot. Leave empty to allow everyone (NOT recommended for production).
# The owner ID 283813172639563779 is the default safe value.
# -----------------------------------------------------------------------
DISCORD_ALLOW_USER_IDS=283813172639563779

# -----------------------------------------------------------------------
# Channel → working directory map (JSON object).
# Key: Discord channel ID, Value: a path on this machine.
# Leading "~" expands to the home directory and relative paths are resolved
# to absolute, so all of these are valid:
# Example: {"1234567890":"~/projects/foo","0987654321":"/srv/bar"}
# Channels not listed fall back to DEFAULT_WORKDIR.
# -----------------------------------------------------------------------
CHANNEL_CWD_MAP={}

# -----------------------------------------------------------------------
# Default working directory used when a channel is not in CHANNEL_CWD_MAP.
# Leading "~" and relative paths are expanded/resolved to absolute.
# When unset, falls back to the running user's home directory.
# Example: DEFAULT_WORKDIR=~/projects
# -----------------------------------------------------------------------
DEFAULT_WORKDIR=

# -----------------------------------------------------------------------
# Permission mode. With "default", tool-use approvals are surfaced as
# interactive Discord buttons (allow / always / deny).
# Options: default | acceptEdits | bypassPermissions
# WARNING: bypassPermissions grants full filesystem/shell access without
# confirmation prompts. Only use in a trusted, isolated environment.
# (Authentication reuses your local `claude` login — no API key needed.)
# -----------------------------------------------------------------------
CLAUDE_PERMISSION_MODE=default

# -----------------------------------------------------------------------
# Per-turn timeout in milliseconds. 0 disables the timeout entirely.
# Default is 1800000 (30 min) — long enough for agentic work (multi-file
# edits, builds/tests, web research). This also covers time spent waiting
# for interactive approvals, so keep it generous. On timeout the query is
# cancelled via AbortController.
# Example: CLAUDE_TIMEOUT_MS=3600000
# -----------------------------------------------------------------------
CLAUDE_TIMEOUT_MS=

# -----------------------------------------------------------------------
# Interactive-UI response timeout in milliseconds — how long to wait for a
# button/select click on an approval, question, or plan prompt. Default is
# 300000 (5 min). 0 disables it (falls back to CLAUDE_TIMEOUT_MS). On
# timeout the bot defaults to the safe choice (deny).
# Example: INTERACTION_TIMEOUT_MS=600000
# -----------------------------------------------------------------------
INTERACTION_TIMEOUT_MS=

# -----------------------------------------------------------------------
# When "true", new sessions are titled with a stable name (dcc-…) so they
# are identifiable in the Claude app's session history. The legacy
# --remote-control flag is no longer used (incompatible with the headless
# SDK query; its purpose is served by the native Discord UI).
# -----------------------------------------------------------------------
REMOTE_CONTROL_ENABLED=true

# -----------------------------------------------------------------------
# Directory for persistent data (sessions.json).
# When unset, falls back to ./data (relative to the project root).
# Absolute paths are recommended.
# Example: DATA_DIR=/var/lib/discord-claude-code
# -----------------------------------------------------------------------
DATA_DIR=

# -----------------------------------------------------------------------
# Claude model identifier forwarded to --model flag.
# Leave empty to use claude's own default.
# -----------------------------------------------------------------------
CLAUDE_MODEL=
